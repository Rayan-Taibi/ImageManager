<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imagemanager.controller.LibraryController"
            id="library-panel">

    <top>
        <VBox spacing="10" style="-fx-padding: 14 12 10 12;">

            <Label text="📚  Bibliothèque"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #89b4fa;"/>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher par tag…"
                           HBox.hgrow="ALWAYS"/>
                <Button text="🔍" onAction="#handleSearch"
                        style="-fx-min-width: 34; -fx-padding: 6 8 6 8;"/>
                <Button text="✕" onAction="#handleClearSearch"
                        styleClass="secondary"
                        style="-fx-min-width: 30; -fx-padding: 6 8 6 8;"/>
            </HBox>

            <Label fx:id="resultCountLabel" text="0 résultat(s)"/>

        </VBox>
    </top>

    <center>
        <ListView fx:id="imageListView" VBox.vgrow="ALWAYS"/>
    </center>

</BorderPane>
