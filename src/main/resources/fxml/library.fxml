<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imagemanager.controller.LibraryController"
            id="library-panel">

    <top>
        <VBox spacing="8" style="-fx-padding: 10;">
            <Label text="📚 Bibliothèque" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <HBox spacing="6">
                <TextField fx:id="searchField" promptText="Search by tag..." HBox.hgrow="ALWAYS"/>
                <Button text="🔍 Chercher" onAction="#handleSearch"/>
                <Button text="✖ Clear" onAction="#handleClearSearch" styleClass="secondary"/>
            </HBox>
            <Label fx:id="resultCountLabel" text="Found: 0"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
            <ListView fx:id="imageListView" prefWidth="150" VBox.vgrow="ALWAYS"/>
            <VBox spacing="10" style="-fx-padding: 10;">
                <ImageView fx:id="previewImageView" fitWidth="200" fitHeight="200" preserveRatio="true"/>
                <Label fx:id="infoLabel" wrapText="true" style="-fx-font-size: 10;"/>
                <Button text="✅ Charger" onAction="#handleLoadForEditing"/>
                <Button text="⟳ Rafraîchir" onAction="#handleRefresh" styleClass="secondary"/>
            </VBox>
        </SplitPane>
    </center>

</BorderPane>
