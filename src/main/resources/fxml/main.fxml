<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imagemanager.controller.MainController">
    <top>
        <VBox spacing="0">
            <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f4f4f4;">
                <Button text="📁 Ouvrir image" onAction="#handleOpenImage"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="labelStatut" text="Prêt" style="-fx-text-fill: #666666;"/>
            </HBox>

            <HBox spacing="15" style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;">
                <Label text="Dimensions:" style="-fx-font-weight: bold;"/>
                <Button text="↺ -90°" onAction="#RotateGauche"/>
                <Button text="↻ +90°" onAction="#RotationDroite"/>
                <Separator orientation="VERTICAL"/>
                <Button text="↔ Miroir H" onAction="#SymmetrieHorizontale"/>
                <Button text="↕ Miroir V" onAction="#SymmetrieVerticale"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <fx:include fx:id="library" source="library.fxml" />
    </left>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #333333;">
            <StackPane>
                <ImageView fx:id="imageView" preserveRatio="true"/>
            </StackPane>
        </ScrollPane>
    </center>

    <right>
        <fx:include fx:id="filter" source="filter.fxml" />
    </right>
</BorderPane>