<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imagemanager.controller.MainController"
            stylesheets="@../css/style.css" id="root">

    <top>
        <VBox spacing="0">
            <HBox id="top-bar">
                <Label text="Gestionnaire d'image" id="titre"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="📁 Ouvrir image" onAction="#handleOpenImage"/>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="labelStatut" text="Prêt"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <fx:include fx:id="library" source="library.fxml"/>
    </left>

    <center>
        <ScrollPane id="canvas-scroll" fitToHeight="true" fitToWidth="true">
            <StackPane>
                <ImageView fx:id="imageView" preserveRatio="true"/>
            </StackPane>
        </ScrollPane>
    </center>

    <right>
        <fx:include fx:id="filter" source="filter.fxml"/>
    </right>

</BorderPane>
