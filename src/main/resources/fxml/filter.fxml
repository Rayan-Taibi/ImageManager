<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox id="filter-panel"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.imagemanager.controller.FilterController">

    <Label text="PANNEAU FILTRES" id="filter-panel-title"/>

    <Separator/>

    <VBox spacing="8">
        <Label text="Couleurs" styleClass="section-label"/>
        <Button text="Sépia"        onAction="#handleSepiaFilter"/>
        <Button text="Noir &amp; Blanc" onAction="#handleNoirBlancFilter"/>
        <Button text="RGB Swap"     onAction="#handleRGBSwapFilter"/>
        <Button text="Contours (Prewitt)" onAction="#handlePrewittFilter"/>

    </VBox>

    <Separator/>

    <VBox spacing="8">
        <Label text="Transformations" styleClass="section-label"/>
        <Button text="↺ -90°" onAction="#RotateGauche"/>
        <Button text="↻ +90°" onAction="#RotationDroite"/>
        <Button text="↔ Miroir H" onAction="#SymmetrieHorizontale"/>
        <Button text="↕ Miroir V" onAction="#SymmetrieVerticale"/>

    </VBox>

    <Separator/>

    <VBox spacing="8">
        <Label text="Tags" styleClass="section-label"/>
        <HBox spacing="5">
            <TextField fx:id="tagInputField" promptText="Enter tag..." HBox.hgrow="ALWAYS"/>
            <Button text="+" onAction="#handleAddTag" prefWidth="40"/>
        </HBox>
        <Label fx:id="tagsLabel" text="Tags: (none)" wrapText="true"/>
    </VBox>

    <Separator/>

    <VBox spacing="8">
        <Label text="Chiffrement" styleClass="section-label"/>
        <TextField fx:id="passwordField" promptText="Password..."/>
        <HBox spacing="5">
            <Button text="Chiffrer" onAction="#handleEncrypt" HBox.hgrow="ALWAYS"/>
            <Button text="Déchiffrer" onAction="#handleDecrypt" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <Separator/>

    <VBox spacing="8">
        <Button text="💾 Sauvegarder Métadonnées" onAction="#handleSaveMetadata" maxWidth="Infinity"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Separator/>

    <VBox spacing="10">
        <Button id="btn-reset" text="Réinitialiser" onAction="#handleReset"/>
        <Label fx:id="statusLabel" text="Ready" wrapText="true" style="-fx-font-size: 10;"/>
    </VBox>

</VBox>

